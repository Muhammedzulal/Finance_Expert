{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finance Expert v1 contracts",
  "description": "Select a named definition with $ref, for example #/$defs/News.",
  "oneOf": [
    {"$ref": "#/$defs/News"},
    {"$ref": "#/$defs/Analysis"},
    {"$ref": "#/$defs/Quote"},
    {"$ref": "#/$defs/Wallet"},
    {"$ref": "#/$defs/TradeRequest"},
    {"$ref": "#/$defs/Trade"},
    {"$ref": "#/$defs/Error"}
  ],
  "$defs": {
    "Id": {"type": "string", "minLength": 1, "maxLength": 200},
    "Version": {"const": "1.0"},
    "Symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$"},
    "Time": {"type": "string", "format": "date-time"},
    "Money": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2,6}$"},
    "SignedMoney": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2,6}$"},
    "News": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "news_id", "source", "source_id", "title", "summary", "url", "published_at", "fetched_at", "symbols", "matched_keywords", "disclosure_type"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/Version"},
        "news_id": {"$ref": "#/$defs/Id"},
        "source": {"enum": ["KAP", "BLOOMBERG_HT"]},
        "source_id": {"type": ["string", "null"], "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]+)?(?:[/?#].*)?$"},
        "published_at": {"anyOf": [{"$ref": "#/$defs/Time"}, {"type": "null"}]},
        "fetched_at": {"$ref": "#/$defs/Time"},
        "symbols": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/Symbol"}},
        "matched_keywords": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "disclosure_type": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "Impact": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "direction", "confidence", "reason"],
      "properties": {
        "symbol": {"$ref": "#/$defs/Symbol"},
        "direction": {"enum": ["positive", "negative", "neutral", "uncertain"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "Analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "analysis_id", "news_id", "model", "prompt_version", "created_at", "summary", "impacts"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/Version"},
        "analysis_id": {"$ref": "#/$defs/Id"},
        "news_id": {"$ref": "#/$defs/Id"},
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "created_at": {"$ref": "#/$defs/Time"},
        "summary": {"type": "string", "minLength": 1},
        "impacts": {"type": "array", "items": {"$ref": "#/$defs/Impact"}}
      }
    },
    "Quote": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "symbol", "price", "currency", "as_of", "provider", "is_delayed"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/Version"},
        "symbol": {"$ref": "#/$defs/Symbol"},
        "price": {"$ref": "#/$defs/Money"},
        "currency": {"const": "TRY"},
        "as_of": {"$ref": "#/$defs/Time"},
        "provider": {"type": "string", "minLength": 1},
        "is_delayed": {"type": "boolean"}
      }
    },
    "Position": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "quantity", "average_cost"],
      "properties": {
        "symbol": {"$ref": "#/$defs/Symbol"},
        "quantity": {"type": "integer", "minimum": 1},
        "average_cost": {"$ref": "#/$defs/Money"}
      }
    },
    "Wallet": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "wallet_id", "currency", "cash_balance", "realized_pnl", "positions", "updated_at"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/Version"},
        "wallet_id": {"$ref": "#/$defs/Id"},
        "currency": {"const": "TRY"},
        "cash_balance": {"$ref": "#/$defs/Money"},
        "realized_pnl": {"$ref": "#/$defs/SignedMoney"},
        "positions": {"type": "array", "items": {"$ref": "#/$defs/Position"}},
        "updated_at": {"$ref": "#/$defs/Time"}
      }
    },
    "TradeRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "symbol", "side", "quantity", "idempotency_key"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/Version"},
        "symbol": {"$ref": "#/$defs/Symbol"},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"type": "integer", "minimum": 1},
        "idempotency_key": {"type": "string", "format": "uuid"}
      }
    },
    "Trade": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "trade_id", "wallet_id", "symbol", "side", "quantity", "idempotency_key", "execution_price", "gross_amount", "currency", "quote_as_of", "executed_at"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/Version"},
        "trade_id": {"$ref": "#/$defs/Id"},
        "wallet_id": {"$ref": "#/$defs/Id"},
        "symbol": {"$ref": "#/$defs/Symbol"},
        "side": {"enum": ["buy", "sell"]},
        "quantity": {"type": "integer", "minimum": 1},
        "idempotency_key": {"type": "string", "format": "uuid"},
        "execution_price": {"$ref": "#/$defs/Money"},
        "gross_amount": {"$ref": "#/$defs/Money"},
        "currency": {"const": "TRY"},
        "quote_as_of": {"$ref": "#/$defs/Time"},
        "executed_at": {"$ref": "#/$defs/Time"}
      }
    },
    "Error": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "error"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/Version"},
        "request_id": {"$ref": "#/$defs/Id"},
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["VALIDATION_ERROR", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "INSUFFICIENT_FUNDS", "INSUFFICIENT_POSITION", "STALE_QUOTE", "IDEMPOTENCY_CONFLICT", "RATE_LIMITED", "SERVICE_UNAVAILABLE"]},
            "message": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
